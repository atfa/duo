/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cache-Control: no-cache

# The page and its scripts are served from this Worker under fixed names, so a
# deploy must reach a phone that reloads. `no-cache` still caches: the phone
# revalidates with the ETag and gets a cheap 304 until the file really changes.
# A `max-age` here would let a phone run the previous app.js for minutes after a
# deploy, which looks exactly like "the fix did not work".

# Rules merge by path instead of replacing each other, so the shared `no-cache`
# above still applies here and would win over any max-age: the first line unsets
# it, otherwise the second is inert.
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400
